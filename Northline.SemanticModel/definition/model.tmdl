model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Backlog","Inventory","Orders","Products","Purchases","Receipts","Shipments","Suppliers","Throughput","Warehouses","Calendar","Reporting Month","Trend Month","Stages","Metrics","DataFolder"]

annotation PBI_ProTooling = ["DevMode"]

ref table Backlog
ref table Inventory
ref table Orders
ref table Products
ref table Purchases
ref table Receipts
ref table Shipments
ref table Suppliers
ref table Throughput
ref table Warehouses
ref table Calendar
ref table 'Reporting Month'
ref table 'Trend Month'
ref table Stages
ref table Metrics

ref cultureInfo en-US

