	partition Products = m
		mode: import
		source =
				let
				 Source = Csv.Document(File.Contents(DataFolder & "Products.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				 Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				 Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				 Typed = Table.TransformColumnTypes(Nulls, {{"ProductID", Int64.Type}, {"SKU", type text}, {"Product", type text}, {"Category", type text}, {"SupplierID", Int64.Type}, {"UnitCostUSD", Currency.Type}, {"DemandClass", type text}}, "en-US")
				in Typed

