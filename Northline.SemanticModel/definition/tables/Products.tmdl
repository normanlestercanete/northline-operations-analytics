		sourceColumn: ProductID

	column SKU
		dataType: string
		lineageTag: 9b3142b8-b6a0-4e01-8609-3490283b751b
		summarizeBy: none
		sourceColumn: SKU

	column Product
		dataType: string
		lineageTag: e6b0ba4a-222f-4b07-965f-7358124a85c7
