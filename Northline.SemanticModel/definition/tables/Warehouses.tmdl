	partition Warehouses = m
		mode: import
		source =
				let
				 Source = Csv.Document(File.Contents(DataFolder & "Warehouses.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				 Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				 Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				 Typed = Table.TransformColumnTypes(Nulls, {{"WarehouseID", Int64.Type}, {"Warehouse", type text}, {"Region", type text}}, "en-US")
				in Typed

