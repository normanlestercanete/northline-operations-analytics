table Warehouses
	lineageTag: eac38b1b-cdce-49e3-a3b6-91d6c20f28e0

	column WarehouseID
		dataType: int64
		formatString: #,0
		lineageTag: 1a4278ec-5527-4e04-b787-d63f8bb6b628
		summarizeBy: none
		sourceColumn: WarehouseID

	column Warehouse
		dataType: string
		lineageTag: 06c30fb1-8cf4-4ab1-bd1c-470e2d921cb6
		summarizeBy: none
