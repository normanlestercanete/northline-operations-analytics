	column OnTime
		dataType: int64
		formatString: #,0
		lineageTag: 659b9595-181b-48fa-8d2b-f1474e755991
		summarizeBy: none
		sourceColumn: OnTime

	partition Receipts = m
		mode: import
		source =
				let
				 Source = Csv.Document(File.Contents(DataFolder & "Receipts.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				 Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				 Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				 Typed = Table.TransformColumnTypes(Nulls, {{"ReceiptID", Int64.Type}, {"PurchaseID", Int64.Type}, {"Date", type date}, {"WarehouseID", Int64.Type}, {"ProductID", Int64.Type}, {"SupplierID", Int64.Type}, {"Units", Int64.Type}, {"ValueUSD", Currency.Type}, {"LeadDays", Int64.Type}, {"OnTime", Int64.Type}}, "en-US")
				in Typed

