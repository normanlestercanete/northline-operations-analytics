	column SupplierID
		dataType: int64
		formatString: #,0
		lineageTag: fd7662bf-3603-4121-a945-cef2e15f74da
		summarizeBy: none
		sourceColumn: SupplierID

	column Units
		dataType: int64
		formatString: #,0
		lineageTag: 0bf35945-1415-4298-a069-83d4d747a1a1
		summarizeBy: none
		sourceColumn: Units

	column ValueUSD
		dataType: decimal
		formatString: $#,0.00
		lineageTag: 267ea5f1-89fc-48b8-88b0-37b3e6ce0560
		summarizeBy: none
		sourceColumn: ValueUSD

	column LeadDays
		dataType: int64
		formatString: #,0
		lineageTag: ac4a7818-a5ab-40f3-bb6f-9b040155f3a8
		summarizeBy: none
