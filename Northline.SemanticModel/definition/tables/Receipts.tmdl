table Receipts
	lineageTag: 8df12827-256a-4125-8488-f986594e975a

	column ReceiptID
		dataType: int64
		formatString: #,0
		lineageTag: cd18893f-b25d-48a8-a3d7-3128b44b74cb
		summarizeBy: none
		sourceColumn: ReceiptID

	column PurchaseID
		dataType: int64
		formatString: #,0
		lineageTag: 0d294f56-1875-4b02-b42c-e71ede55321e
		summarizeBy: none
		sourceColumn: PurchaseID

	column Date
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 1b106f05-7660-47fc-bf36-c2e9ee19df2e
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column WarehouseID
		dataType: int64
		formatString: #,0
		lineageTag: e0c686a2-0a7a-4836-b372-aa235bde95cb
		summarizeBy: none
		sourceColumn: WarehouseID

	column ProductID
		dataType: int64
		formatString: #,0
		lineageTag: b5327897-45ed-44f4-b828-48b5bd7aa8da
		summarizeBy: none
