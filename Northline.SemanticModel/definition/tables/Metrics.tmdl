	measure 'Age 0to30 Previous' =
			VAR D = EDATE ( [Selected Month], -1 )
			RETURN IF ( D >= DATE ( 2024, 1, 1 ), CALCULATE ( [Age 0to30 Base], REMOVEFILTERS ( Calendar ), DATESBETWEEN ( Calendar[Date], D, EOMONTH ( D, 0 ) ) ) )
		formatString: $#,0;($#,0);$0
		displayFolder: Supporting
		lineageTag: 5b6f068b-d45d-40c0-8609-dc3793a3849f

	measure 'Age 0to30 Trend' =
			VAR D = SELECTEDVALUE ( 'Trend Month'[MonthStart] )
			RETURN IF ( NOT ISBLANK ( D ) && D >= EDATE ( [Selected Month], -11 ) && D <= [Selected Month], CALCULATE ( [Age 0to30 Base], REMOVEFILTERS ( Calendar ), DATESBETWEEN ( Calendar[Date], D, EOMONTH ( D, 0 ) ) ) )
		formatString: $#,0;($#,0);$0
		displayFolder: Supporting
		lineageTag: 058885a9-301a-4760-a87f-8534cf5b61b1

	measure 'Age 0to30 Change' =
			VAR P = [Age 0to30 Previous]
			RETURN IF ( ISBLANK ( P ) || ISBLANK ( [Age 0to30] ), "N/A", IF ( P = 0, "N/A", FORMAT ( DIVIDE ( [Age 0to30] - P, P ), "+0.0%;-0.0%;0.0%" ) ) )
		displayFolder: Supporting
		lineageTag: 803ff3f6-c305-4e66-8b09-3f7a22f485df

	measure 'Age 0to30 Color' =
			VAR P = [Age 0to30 Previous]
			VAR Delta = ( [Age 0to30] - P )
			RETURN SWITCH ( TRUE (), ISBLANK ( P ) || ISBLANK ( [Age 0to30] ), "#000000", Delta > 0.000001, "#237A42", Delta < -0.000001, "#B3261E", "#000000" )
		displayFolder: Supporting
		lineageTag: afc3d338-562d-4fff-b596-b1c773251fa7

