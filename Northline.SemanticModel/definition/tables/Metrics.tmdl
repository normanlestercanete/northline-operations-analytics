table Metrics
	lineageTag: 1e803e06-6474-414b-a202-6fb671649d1a

	measure 'Selected Month' = SELECTEDVALUE ( 'Reporting Month'[MonthStart], MAX ( 'Reporting Month'[MonthStart] ) )
		formatString: yyyy-MM-dd
		displayFolder: Performance
		lineageTag: d05a4a96-ec05-40fb-878f-cbc24ba7d8d1

	measure 'Shipped Units Base' = SUM ( Shipments[Units] )
		formatString: #,0
		displayFolder: Supporting
		lineageTag: a0b1df0f-abf6-4f22-9628-a40cecd780cf

	measure 'Shipped Units' =
			VAR D = [Selected Month]
			RETURN IF ( D >= DATE ( 2024, 1, 1 ), CALCULATE ( [Shipped Units Base], REMOVEFILTERS ( Calendar ), DATESBETWEEN ( Calendar[Date], D, EOMONTH ( D, 0 ) ) ) )
		formatString: #,0
		displayFolder: Performance
		lineageTag: 6755ee0a-a951-4af2-aa26-291861c94e4c

	measure 'Shipped Units Previous' =
			VAR D = EDATE ( [Selected Month], -1 )
			RETURN IF ( D >= DATE ( 2024, 1, 1 ), CALCULATE ( [Shipped Units Base], REMOVEFILTERS ( Calendar ), DATESBETWEEN ( Calendar[Date], D, EOMONTH ( D, 0 ) ) ) )
		formatString: #,0
		displayFolder: Supporting
		lineageTag: 25fdbb0c-52e9-4381-944d-c4576e85d4a0

	measure 'Shipped Units Trend' =
			VAR D = SELECTEDVALUE ( 'Trend Month'[MonthStart] )
			RETURN IF ( NOT ISBLANK ( D ) && D >= EDATE ( [Selected Month], -11 ) && D <= [Selected Month], CALCULATE ( [Shipped Units Base], REMOVEFILTERS ( Calendar ), DATESBETWEEN ( Calendar[Date], D, EOMONTH ( D, 0 ) ) ) )
		formatString: #,0
		displayFolder: Supporting
		lineageTag: f61e7b73-c6b0-4152-8d35-2b84a0896f78

	measure 'Shipped Units Change' =
			VAR P = [Shipped Units Previous]
			RETURN IF ( ISBLANK ( P ) || ISBLANK ( [Shipped Units] ), "N/A", IF ( P = 0, "N/A", FORMAT ( DIVIDE ( [Shipped Units] - P, P ), "+0.0%;-0.0%;0.0%" ) ) )
		displayFolder: Supporting
		lineageTag: a1af4644-03f8-4a00-a323-b7a24e50c888

	measure 'Shipped Units Color' =
			VAR P = [Shipped Units Previous]
			VAR Delta = ( [Shipped Units] - P )
			RETURN SWITCH ( TRUE (), ISBLANK ( P ) || ISBLANK ( [Shipped Units] ), "#000000", Delta > 0.000001, "#237A42", Delta < -0.000001, "#B3261E", "#000000" )
		displayFolder: Supporting
		lineageTag: 1b4ba77c-eaa9-44ff-8032-881da51a0c18

